[sub_resource type="GDScript" id="GDScript_fevyy"]
script/source = "extends AudioStreamPlayer


@export var hud: HUD = null

func _process(delta: float) -> void:
	if (hud != null):
		volume_db = hud.vignette.strength * 20
"

